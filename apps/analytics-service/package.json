{
  "name": "@flashurl/analytics-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:undo": "tsx scripts/migrate.ts down"
  },
  "dependencies": {
    "@flashurl/contracts": "^1.0.0",
    "@flashurl/errors": "^1.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
